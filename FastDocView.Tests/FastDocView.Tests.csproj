<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console test harness (no test framework, like KitveiHakodeshService.Tests): deflate
       round-trip + random seeks, synthetic big-docx index/render, and a smoke run over real
       .docx/.doc files. `dotnet run -c Release` prints per-step progress and timings. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FastDocView\FastDocView.csproj" />
  </ItemGroup>

</Project>
