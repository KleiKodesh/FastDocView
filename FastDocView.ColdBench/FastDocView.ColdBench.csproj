<Project Sdk="Microsoft.NET.Sdk">
  <!-- Cold first paint in the SHIPPED configuration: the app's KitveiHakodesh service is native AOT
       (PublishAot, InvariantGlobalization, workstation concurrent GC, GCConserveMemory 9), so this
       is published the same way. dotnet publish -c Release -r win-x64, then
       FastDocView.ColdBench.exe [runs option] file... (a fresh process per run, empty cache). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
    <ProjectReference Include="..\FastDocView\FastDocView.csproj" />
  </ItemGroup>
</Project>
