<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-written: bullet fonts given by style:font-name, a font-face-decls name that differs from the family it declares.
     LibreOffice resolves it through the declaration (xmloff/source/style/xmlnumi.cxx:645-694); its print is bullet-font-name-v1.pdf. -->
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
  xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
  xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
  <office:font-face-decls>
    <style:font-face style:name="BulletFaceW" svg:font-family="Wingdings" style:font-pitch="variable" style:font-charset="x-symbol"/>
    <style:font-face style:name="BulletFaceS" svg:font-family="Symbol" style:font-pitch="variable" style:font-charset="x-symbol"/>
    <style:font-face style:name="Arial" svg:font-family="Arial"/>
  </office:font-face-decls>
  <office:styles>
    <style:default-style style:family="paragraph"><style:text-properties style:font-name="Arial" fo:font-size="11pt"/></style:default-style>
    <text:list-style style:name="NamedW">
      <text:list-level-style-bullet text:level="1" text:bullet-char="&#xF0A7;">
        <style:list-level-properties text:list-level-position-and-space-mode="label-alignment">
          <style:list-level-label-alignment text:label-followed-by="listtab" text:list-tab-stop-position="0.5in" fo:text-indent="-0.25in" fo:margin-left="0.5in"/>
        </style:list-level-properties>
        <style:text-properties style:font-name="BulletFaceW"/>
      </text:list-level-style-bullet>
    </text:list-style>
  </office:styles>
  <office:automatic-styles>
    <text:list-style style:name="NamedS">
      <text:list-level-style-bullet text:level="1" text:bullet-char="&#xF0B7;">
        <style:list-level-properties text:list-level-position-and-space-mode="label-alignment">
          <style:list-level-label-alignment text:label-followed-by="listtab" text:list-tab-stop-position="0.5in" fo:text-indent="-0.25in" fo:margin-left="0.5in"/>
        </style:list-level-properties>
        <style:text-properties style:font-name="BulletFaceS"/>
      </text:list-level-style-bullet>
    </text:list-style>
  </office:automatic-styles>
  <office:body>
    <office:text>
      <text:list text:style-name="NamedW"><text:list-item><text:p>font-name Wingdings</text:p></text:list-item></text:list>
      <text:list text:style-name="NamedS"><text:list-item><text:p>font-name Symbol</text:p></text:list-item></text:list>
    </office:text>
  </office:body>
</office:document>
