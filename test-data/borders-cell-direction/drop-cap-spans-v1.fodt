<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
  xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
  xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:loext="urn:org:documentfoundation:names:experimental:office:xmlns:loext:1.0"
  office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:styles>
  <style:default-style style:family="paragraph"><style:text-properties fo:font-size="12pt" fo:language="en" fo:country="US"/></style:default-style>
 </office:styles>
 <office:automatic-styles>
  <style:style style:name="Three" style:family="paragraph"><style:paragraph-properties><style:drop-cap style:length="3" style:lines="2" style:distance="0.1in"/></style:paragraph-properties></style:style>
  <style:style style:name="Word" style:family="paragraph"><style:paragraph-properties><style:drop-cap style:length="word" style:lines="3"/></style:paragraph-properties></style:style>
  <style:style style:name="Red" style:family="text"><style:text-properties fo:color="#ff0000"/></style:style>
  <style:style style:name="Bold" style:family="text"><style:text-properties fo:font-weight="bold" fo:font-size="20pt"/></style:style>
  <style:style style:name="Down" style:family="table-cell"><style:table-cell-properties fo:border="0.5pt solid #000000" style:writing-mode="tb-rl"/></style:style>
  <style:style style:name="Up" style:family="table-cell"><style:table-cell-properties fo:border="0.5pt solid #000000" style:writing-mode="tb-rl" loext:writing-mode="bt-lr"/></style:style>
  <style:style style:name="Flat" style:family="table-cell"><style:table-cell-properties fo:border="0.5pt solid #000000"/></style:style>
  <style:style style:name="Row" style:family="table-row"><style:table-row-properties style:row-height="1.2in"/></style:style>
 </office:automatic-styles>
 <office:body>
  <office:text>
   <text:p text:style-name="Three"><text:span text:style-name="Red">A</text:span><text:span text:style-name="Bold">bc</text:span>def three characters over two spans make the initial of this paragraph, which runs on long enough to wrap around the dropped letters on the second line.</text:p>
   <text:p text:style-name="Word">Wo<text:span text:style-name="Red">rd</text:span> rest: the whole first word, split over a span, drops three lines while this paragraph runs on long enough to wrap around it for a few lines of ordinary text.</text:p>
   <text:p text:style-name="Three">X<text:tab/>Tab ends the initial after one character, as LibreOffice stops a drop cap at a tab; the paragraph runs on long enough to fill more than two lines, so that the initial really drops over two lines of text.</text:p>
   <table:table table:name="Cells">
    <table:table-column table:number-columns-repeated="3"/>
    <table:table-row table:style-name="Row">
     <table:table-cell table:style-name="Flat"><text:p>Flat</text:p></table:table-cell>
     <table:table-cell table:style-name="Down"><text:p>Down</text:p></table:table-cell>
     <table:table-cell table:style-name="Up"><text:p>Up</text:p></table:table-cell>
    </table:table-row>
   </table:table>
  </office:text>
 </office:body>
</office:document>
