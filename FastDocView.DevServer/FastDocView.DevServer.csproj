<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Dev-only localhost JSON host for the library, the counterpart of the app's loopback
       service in dev: the Vite demo (../vue-demo) talks to http://127.0.0.1:5188/api/... and
       renders with the app's own WindowedScroller, so behaviour is debugged live in the browser.
       Not shipped; the real host is the KitveiHakodesh service. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FastDocView\FastDocView.csproj" />
  </ItemGroup>

</Project>
